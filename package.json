{
  "name": "ai-adversarial-obfuscator",
  "version": "0.1.0",
  "description": "JavaScript obfuscation with optional adversarial LLM-analysis decoys, CLI and Vite plugin",
  "license": "MIT",
  "author": "Seohyun Lee <me@seorii.page>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seo-rii/ai-adversarial-obfuscator.git"
  },
  "homepage": "https://github.com/seo-rii/ai-adversarial-obfuscator#readme",
  "bugs": {
    "url": "https://github.com/seo-rii/ai-adversarial-obfuscator/issues"
  },
  "keywords": [
    "javascript",
    "obfuscation",
    "vite-plugin",
    "cli",
    "code-analysis"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./src/core.d.mts",
      "default": "./src/core.mjs"
    },
    "./vite": {
      "types": "./src/vite.d.mts",
      "default": "./src/vite.mjs"
    }
  },
  "bin": {
    "ai-obfuscate": "./bin/ai-obfuscate.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:unit": "node --test test/core.test.mjs test/cli.test.mjs",
    "test:vite": "node --test test/vite.test.mjs",
    "build:fixture": "vite build --config fixtures/vite/vite.config.mjs"
  },
  "dependencies": {
    "javascript-obfuscator": "^5.10.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
